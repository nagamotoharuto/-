generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String       @id @default(cuid())
  name        String
  // food | drink | goods（パンとお菓子はどちらも food）
  category    String
  // food のときだけ使う内訳：bread | sweets
  // 図鑑・パンの購入上限・スタンプ特典・AIカメラのカウントはパンだけが対象なので、
  // 売り場の区分を3つにまとめてもパンとお菓子は区別できるようにしておく。
  subCategory String       @default("")
  price       Int
  imageUrl    String
  // Live count of what is physically on the shelf right now (kept up to date by
  // the camera's AI count). Advance reservations are NOT capped by this — they
  // are capped by the sale day's planned quantity in DailyStock.
  stock       Int          @default(0)
  description String       @default("")
  isAvailable Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orderItems  OrderItem[]
  dailyStocks DailyStock[]
}

// How many of a product the bakery is producing for one sale day. Decided on
// (or before) the previous business day, which is what makes reservations for
// that day possible. RESERVATION_RATIO of this is bookable in advance.
model DailyStock {
  id         String   @id @default(cuid())
  productId  String
  date       String // 販売日 "YYYY-MM-DD" (JST)
  plannedQty Int      @default(0) // 発注数
  // 閉店時の残数。staff enter it at closing, so 実売数 = plannedQty - closingQty.
  // null は未入力（閉店処理がまだ済んでいない）を表す。
  // 店頭在庫。発注数と同じ数から始め、飛び込み客に売れるたびに販売員が1つずつ減らす。
  // カメラのAIカウント(Product.stock)とは別物で、こちらが販売員の管理する数。
  shelfQty   Int?
  closingQty Int?
  closedAt   DateTime?
  // 店頭在庫が初めて0になった時刻。カメラのAIカウント由来で、
  // 導入前後の「売り切れ時刻」比較の材料になる。
  soldOutAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([date])
}

// 飛び込み客が売り切れで買えなかった件数。アプリからは観測できないため、
// 販売員が店頭でタップして1件ずつ記録する。
model SoldOutTurnaway {
  id          String   @id @default(cuid())
  date        String // 販売日 "YYYY-MM-DD" (JST)
  productName String   @default("") // 分かれば何を求めていたか
  recordedAt  DateTime @default(now())

  @@index([date])
}

model Order {
  id            String      @id @default(cuid())
  nickname      String
  email         String      @default("")
  userType      String
  pickupDate    String      @default("") // 受け取り日 "YYYY-MM-DD" (JST)
  pickupTime    String
  paymentMethod String
  // pending | ready | completed | cancelled | released
  // "released" = 受け取り時間を過ぎても来店がなく、自動で解放して店頭販売に戻した予約
  status        String      @default("pending")
  releasedAt    DateTime?
  totalAmount   Int
  orderNumber   String      @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]

  @@index([pickupDate])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Int
  // Snapshotted at order time so past orders keep showing what was actually
  // purchased even if the Product row is later renamed/reused for a
  // different item (e.g. staff repurposing a bread slot for the next day's bake).
  name        String
  imageUrl    String
  category    String
  subCategory String  @default("")
  order       Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

// 商品写真の実体。Next.jsの本番ビルドは public/ にビルド時からあるファイルしか
// 配信しないうえ、Railwayのコンテナはファイルが永続しない。どちらの制約も受けない
// ようDBに置き、/api/images/[id] から配信する。
model ProductImage {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String
  byteSize  Int
  createdAt DateTime @default(now())
}

model StampCard {
  id                String   @id @default(cuid())
  nickname          String   @unique
  stamps            Int      @default(0)
  totalOrders       Int      @default(0)
  streak            Int      @default(0)
  lastOrderDate     String   @default("")
  freeItemAvailable Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
